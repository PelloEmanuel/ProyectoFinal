{
  "expo": {
    "name": "Campus Técnica 5",
    "slug": "campus-tecnica-5",
    "owner": "pelloemanuel",
    "scheme": "campus",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#b91c1c",
    "android": {
      "package": "com.campustecnica5.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "campus"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.campustecnica5.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "expo-font"
    ]
  }
}
