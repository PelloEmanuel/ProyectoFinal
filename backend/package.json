{
  "name": "campus-backend",
  "version": "1.0.0",
  "description": "API REST del Campus (Express + MySQL + JWT + TOTP 2FA)",
  "main": "src/servidor.ts",
  "scripts": {
    "start": "tsx src/servidor.ts",
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc --noEmit",
    "init-db": "tsx src/programas/iniciarBaseDatos.ts",
    "seed": "tsx src/programas/semillaDatos.ts",
    "test": "tsx pruebas/api.prueba.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.16"
  }
}
