PORT=3000
NODE_ENV=development

# MySQL / MariaDB (Campus)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skilltrack

# Inicializar esquema y datos iniciales automáticamente al arrancar
AUTO_INIT_DB=true

# Seguridad JWT y cifrado de secretos TOTP (2FA)
JWT_ACCESS_SECRET=cambiar_este_secreto_jwt_largo_y_aleatorio
JWT_ACCESS_EXPIRES=15m
REFRESH_DAYS=30
TOTP_ENCRYPTION_KEY=cambiar_esta_clave_cifrado_totp_32_caracteres

# OAuth 2.0 / OpenID Connect (Google, GitHub, Facebook/Meta)
GOOGLE_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Correo SMTP (verificación de correo, recuperación de contraseña y avisos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus <no-reply@skilltrack.edu>"
APP_PUBLIC_URL=http://localhost:3000
