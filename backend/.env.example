PORT=3000
NODE_ENV=development

# PostgreSQL en Render (pegá acá la External Database URL o Internal Database URL en tu .env local/Render, NUNCA en el repo)
DATABASE_URL=

# O bien conexión PostgreSQL por partes (si corrés Postgres local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=taskflow
DB_SSL=false

# Inicializar tablas y datos base automáticamente al arrancar el servidor
AUTO_INIT_DB=true

# JWT (usar cadenas largas y aleatorias)
JWT_ACCESS_SECRET=cambiar_este_secreto_access
JWT_ACCESS_EXPIRES=15m
REFRESH_DAYS=30

# Proveedores sociales (solo GitHub requiere secret en el backend)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP para el código de 2 pasos (si se deja vacío, el código se imprime en consola)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <no-reply@taskflow.app>"
